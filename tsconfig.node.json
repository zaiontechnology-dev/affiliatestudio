{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023"],
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "isolatedModules": true, "types": ["node"], "noEmit": true
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/core/**/*", "src/database/**/*", "src/security/**/*", "src/services/**/*", "src/automation/**/*", "src/intelligence/**/*", "src/analytics/**/*", "src/integrations/**/*", "tests/**/*", "electron.vite.config.ts", "vitest.config.ts"]
}
